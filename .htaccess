# 1. Bloqueio de arquivos e pontos ocultos sensiveis
<FilesMatch "(^\.|\.env|banco\.sql|composer\.(json|lock)|phpunit\.xml)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 2. Cabecalhos HTTP de Seguranca
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Regras de Reescrita e Protecao de Diretorios
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(tests|updates|docs|install)/ - [F,L]
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
